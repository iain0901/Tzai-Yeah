# Copy to .env. Change PUBLIC_ORIGIN to your actual HTTPS domain before writing NFC tags.
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
# Local Node binds loopback; Docker Compose overrides this to 0.0.0.0 inside the container.
HOSTNAME=127.0.0.1
DATABASE_PATH=./data/tzai.sqlite
SECRETS_DIR=./secrets
SESSION_SECRET_FILE=./secrets/session-secret

# First initialization only. A random password is saved privately to secrets/admin-login.txt.
ADMIN_EMAIL=admin@tzai.local
ADMIN_NAME=載耶管理員
INIT_CARD_COUNT=150
# Optional existing NFC CSV: preserves the card numbers and tokens, before generating new cards.
# NFC_IMPORT_FILE=./imports/cards.csv

# Optional overrides. Prefer a secret file or secret manager; never commit real values.
# SESSION_SECRET=<64 random hexadecimal characters>
# ADMIN_PASSWORD=<at least 12 characters>
# ALLOW_REGISTRATION=true
# TRUST_PROXY=false
